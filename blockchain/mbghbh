# 8. WEYL CURVATURE DECLINATION
# ============================================================================

def compute_weyl_curvature_proxy(H, psi_trajectory):
    """
    Compute proxy for Weyl curvature declination along worldline.
    
    D_W = ⟨ψ_n | [H, [H, ρ_n]] | ψ_n⟩
    
    where ρ_n = |ψ_n⟩⟨ψ_n| is the density matrix.
    This measures non-integrability/curvature of evolution.
    """
    n_steps = psi_trajectory.shape[0]
    curvatures = np.zeros(n_steps)
    
    for n in range(n_steps):
        psi_n = psi_trajectory[n]
        rho_n = np.outer(psi_n, psi_n.conj())
        
        # Double commutator [H, [H, ρ]]
        comm1 = H @ rho_n - rho_n @ H
        comm2 = H @ comm1 - comm1 @ H
        
        # Expectation value
        curvatures[n] = np.real(np.trace(rho_n @ comm2))
    
    return curvatures

weyl_curvatures = compute_weyl_curvature_proxy(H, trajectory)

